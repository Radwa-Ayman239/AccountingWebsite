# Supabase Configuration
# In Vercel: Project → Settings → Environment Variables.
# Add both variables for Production, Preview, and Development, then redeploy.
# NEXT_PUBLIC_* values are inlined at build time. A runtime-only change is not enough.
# Use the Project URL and the anon / publishable key (sb_publishable_... or the JWT anon key).
# Do not put the service_role or secret key here. The app talks to Postgres through RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Public site origin, no trailing slash. Used as the email confirmation redirect.
# In Vercel set this to the production URL, for example https://your-app.vercel.app
# In Supabase → Authentication → URL Configuration, set Site URL to the same origin
# and allow /auth/callback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
